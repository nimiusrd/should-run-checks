{
  "name": "should-run-checks",
  "version": "0.3.0",
  "private": true,
  "description": "変更パスとworkflow入力からCIの実行要否を判定するGitHub Action",
  "license": "MIT",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run typecheck && node --check dist/index.js"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  }
}
