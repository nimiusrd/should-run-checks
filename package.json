{
  "name": "should-run-checks",
  "version": "1.0.1",
  "private": true,
  "description": "変更パスとworkflow入力からCIの実行要否を判定するGitHub Action",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run typecheck && node --check dist/index.js"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  }
}
